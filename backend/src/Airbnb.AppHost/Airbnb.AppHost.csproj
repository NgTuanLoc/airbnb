<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>8f3b6c1e-2d47-4a9e-b5c8-1e6f0a7d9c42</UserSecretsId>
    <!-- AspireUseCliBundle stays off: DCP and the dashboard come from NuGet, so build/test work without the Aspire CLI (CI). -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.Functions" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.Kafka" />
    <PackageReference Include="Aspire.Hosting.MongoDB" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.k6" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.LavinMQ" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.Yarp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Airbnb.Api\Airbnb.Api.csproj" />
    <ProjectReference Include="..\Airbnb.Functions\Airbnb.Functions.csproj" />
    <ProjectReference Include="..\Airbnb.MigrationService\Airbnb.MigrationService.csproj" />
    <!-- The notification service lives in its own solution (services/notifications); this AppHost still runs it. -->
    <ProjectReference Include="..\..\..\services\notifications\src\Airbnb.Notifications\Airbnb.Notifications.csproj" />
    <!-- So does the payment service (services/payments). -->
    <ProjectReference Include="..\..\..\services\payments\src\Airbnb.Payments\Airbnb.Payments.csproj" />
    <!-- And the chat service (services/chat). -->
    <ProjectReference Include="..\..\..\services\chat\src\Airbnb.Chat\Airbnb.Chat.csproj" />
    <!-- And the assistant (services/assistant). -->
    <ProjectReference Include="..\..\..\services\assistant\src\Airbnb.Assistant\Airbnb.Assistant.csproj" />
  </ItemGroup>

</Project>
